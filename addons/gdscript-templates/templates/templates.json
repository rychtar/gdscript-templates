{
	"tool": {"body": "@tool\n|CURSOR|", "description": "Run the script in the editor (@tool)"},
	"class": {"body": "class_name {name}\nextends {parent=Node}\n\n|CURSOR|", "description": "class_name and extends header"},
	"export": {"body": "@export var {name}: {type=float}|CURSOR|", "description": "Exported variable (@export)"},
	"exprange": {"body": "@export_range({min=0}, {max=100}) var {name}: {type=float} = |CURSOR|", "description": "Exported variable with a range slider (@export_range)"},
	"expnode": {"body": "@export var {name}: {node_type=Node} = |CURSOR|", "description": "Exported node reference"},
	"expgroup": {"body": "@export_group(\"{name}\")\n|CURSOR|", "description": "Group the following exported variables in the inspector"},
	"expenum": {"body": "@export_enum(\"{a=A}\", \"{b=B}\") var {name}: String = \"{a}\"|CURSOR|", "description": "Exported string picked from a list (@export_enum)"},
	"expmulti": {"body": "@export_multiline var {name}: String|CURSOR|", "description": "Exported multiline text (@export_multiline)"},
	"expfile": {"body": "@export_file var {name}: String = \"|CURSOR|\"", "description": "Exported file path (@export_file)"},
	"onready": {"body": "@onready var {name}: {type=Node} = ${path}|CURSOR|", "description": "@onready variable with a $NodePath"},
	"onrget": {"body": "@onready var {name}: {type=Node} = get_node(\"{path}\")|CURSOR|", "description": "@onready variable with get_node()"},

	"ready": {"body": "func _ready() -> void:\n\t|CURSOR|", "description": "_ready() - called when the node enters the scene tree"},
	"process": {"body": "func _process(delta: float) -> void:\n\t|CURSOR|", "description": "_process() - called every frame"},
	"physics": {"body": "func _physics_process(delta: float) -> void:\n\t|CURSOR|", "description": "_physics_process() - called every physics frame"},
	"input": {"body": "func _input(event: InputEvent) -> void:\n\t|CURSOR|", "description": "_input() - handle input events"},
	"uninput": {"body": "func _unhandled_input(event: InputEvent) -> void:\n\t|CURSOR|", "description": "_unhandled_input() - input not handled by the GUI"},
	"draw": {"body": "func _draw() -> void:\n\t|CURSOR|", "description": "_draw() - custom drawing"},
	"enter": {"body": "func _enter_tree() -> void:\n\t|CURSOR|", "description": "_enter_tree() - called when entering the scene tree"},
	"exit": {"body": "func _exit_tree() -> void:\n\t|CURSOR|", "description": "_exit_tree() - called when leaving the scene tree"},
	"confwarn": {"body": "func _get_configuration_warnings() -> PackedStringArray:\n\tvar warnings := PackedStringArray()\n\t|CURSOR|\n\treturn warnings", "description": "Node configuration warnings shown in the scene tree"},
	"notif": {"body": "func _notification(what: int) -> void:\n\tmatch what:\n\t\t|CURSOR|", "description": "_notification() with a match"},

	"func": {"body": "func {name}({params=}) -> {return_type=void}:\n\t|CURSOR|", "description": "Function with parameters and return type"},
	"fv": {"body": "func {name}() -> void:\n\t|CURSOR|", "description": "Function without parameters returning void"},
	"static": {"body": "static func {name}({params=}) -> {return_type=void}:\n\t|CURSOR|", "description": "Static function"},

	"lambda": {"body": "func({params=}): |CURSOR|", "description": "Lambda function"},
	"supercall": {"body": "super.{method}({args=})|CURSOR|", "description": "Call the parent class method"},

	"signal": {"body": "signal {name}({params=})|CURSOR|", "description": "Signal declaration"},
	"sigcon": {"body": "{signal}.connect(_on_{signal})|CURSOR|", "description": "Connect a signal to _on_<signal>"},
	"sigem": {"body": "{signal}.emit({args=})|CURSOR|", "description": "Emit a signal"},
	"awaitsig": {"body": "await {signal}\n|CURSOR|", "description": "Wait for a signal"},
	"ondis": {"body": "{signal}.disconnect(_on_{signal})|CURSOR|", "description": "Disconnect a signal from _on_<signal>"},

	"prop": {"body": "var {name}: {type=float}:\n\tget:\n\t\treturn {name}\n\tset(value):\n\t\t{name} = value\n\t\t|CURSOR|", "description": "Property with getter and setter"},
	"propget": {"body": "var {name}: {type=float}:\n\tget:\n\t\treturn |CURSOR|", "description": "Property with a getter"},
	"propset": {"body": "var {name}: {type=float}:\n\tset(value):\n\t\t|CURSOR|", "description": "Property with a setter"},

	"if": {"body": "if {condition}:\n\t{selection}|CURSOR|", "description": "if block, wraps the selected code"},
	"ife": {"body": "if {condition}:\n\t{selection}|CURSOR|\nelse:\n\tpass", "description": "if / else block, wraps the selected code"},
	"for": {"body": "for {item} in {collection}:\n\t{selection}|CURSOR|", "description": "for loop over a collection, wraps the selected code"},
	"fori": {"body": "for i in range({count=10}):\n\t{selection}|CURSOR|", "description": "for loop with an index, wraps the selected code"},
	"while": {"body": "while {condition}:\n\t{selection}|CURSOR|", "description": "while loop, wraps the selected code"},
	"match": {"body": "match {value}:\n\t{case}:\n\t\t|CURSOR|\n\t_:\n\t\tpass", "description": "match statement with a default case"},

	"isnull": {"body": "if {value} != null:\n\t{selection}|CURSOR|", "description": "Null check, wraps the selected code"},
	"isval": {"body": "if is_instance_valid({object}):\n\t{selection}|CURSOR|", "description": "is_instance_valid() check, wraps the selected code"},
	"guard": {"body": "if not {condition}:\n\treturn|CURSOR|", "description": "Guard clause - return early"},
	"assert": {"body": "assert({condition}, \"{message}\")|CURSOR|", "description": "Assertion with a message"},

	"ia": {"body": "Input.is_action_pressed(\"{action}\")|CURSOR|", "description": "Is an input action held down"},
	"iaj": {"body": "Input.is_action_just_pressed(\"{action}\")|CURSOR|", "description": "Was an input action just pressed"},
	"iar": {"body": "Input.is_action_just_released(\"{action}\")|CURSOR|", "description": "Was an input action just released"},
	"iak": {"body": "Input.is_key_pressed(KEY_{key})|CURSOR|", "description": "Is a keyboard key pressed"},
	"evact": {"body": "if event.is_action_pressed(\"{action}\"):\n\t{selection}|CURSOR|", "description": "Check an input action in _input(), wraps the selected code"},
	"ims": {"body": "Input.is_mouse_button_pressed(MOUSE_BUTTON_{button=LEFT})|CURSOR|", "description": "Is a mouse button pressed"},

	"dict": {"body": "var {name}: Dictionary = {\n\t\"{key}\": |CURSOR|\n}", "description": "Dictionary with one entry"},
	"dictempty": {"body": "var {name}: Dictionary = {}|CURSOR|", "description": "Empty dictionary"},
	"dicthas": {"body": "if {dict}.has(\"{key}\"):\n\t{selection}|CURSOR|", "description": "Check if a dictionary has a key, wraps the selected code"},
	"dictget": {"body": "{dict}.get(\"{key}\", {default=null})|CURSOR|", "description": "Dictionary value with a default"},
	"dictkeys": {"body": "for key in {dict}.keys():\n\t|CURSOR|", "description": "Loop over dictionary keys"},
	"dictvals": {"body": "for value in {dict}.values():\n\t|CURSOR|", "description": "Loop over dictionary values"},
	"dictitems": {"body": "for key in {dict}:\n\tvar value = {dict}[key]\n\t|CURSOR|", "description": "Loop over dictionary keys and values"},
	"dictmerge": {"body": "{dict1}.merge({dict2}, true)|CURSOR|", "description": "Merge dictionaries, overwriting existing keys"},
	"dictdup": {"body": "var {new_dict} = {dict}.duplicate(true)|CURSOR|", "description": "Deep copy of a dictionary"},
	"dicterase": {"body": "{dict}.erase(\"{key}\")|CURSOR|", "description": "Remove a key from a dictionary"},
	"dictclear": {"body": "{dict}.clear()|CURSOR|", "description": "Remove all dictionary entries"},

	"addch": {"body": "add_child({node})|CURSOR|", "description": "Add a child node"},
	"remch": {"body": "remove_child({node})|CURSOR|", "description": "Remove a child node"},
	"qfree": {"body": "queue_free()|CURSOR|", "description": "Delete the node at the end of the frame"},
	"getnode": {"body": "get_node(\"{path}\")|CURSOR|", "description": "Get a node by path"},
	"hasnode": {"body": "has_node(\"{path}\")|CURSOR|", "description": "Check if a node exists at a path"},
	"findch": {"body": "find_child(\"{name}\", true, false)|CURSOR|", "description": "Find a descendant node by name"},
	"gettree": {"body": "get_tree()|CURSOR|", "description": "The SceneTree"},
	"getparent": {"body": "get_parent()|CURSOR|", "description": "The parent node"},
	"getchildren": {"body": "get_children()|CURSOR|", "description": "All child nodes"},

	"chscene": {"body": "get_tree().change_scene_to_file(\"{path=res://}\")|CURSOR|", "description": "Switch to another scene"},
	"fread": {"body": "var file = FileAccess.open(\"{path=user://save.dat}\", FileAccess.READ)\nif file:\n\tvar content = file.get_as_text()\n\t|CURSOR|", "description": "Read a text file (FileAccess)"},
	"fwrite": {"body": "var file = FileAccess.open(\"{path=user://save.dat}\", FileAccess.WRITE)\nif file:\n\tfile.store_string({content})|CURSOR|", "description": "Write a text file (FileAccess)"},

	"inst": {"body": "var {var_name} = {scene}.instantiate()\n|CURSOR|", "description": "Instantiate a PackedScene"},
	"load": {"body": "var {var_name} = load(\"{path}\")|CURSOR|", "description": "Load a resource at runtime"},
	"preload": {"body": "const {const_name} = preload(\"{path}\")|CURSOR|", "description": "Preload a resource into a constant"},

	"timer": {"body": "await get_tree().create_timer({seconds=1.0}).timeout\n|CURSOR|", "description": "Wait for a number of seconds"},
	"calldef": {"body": "call_deferred(\"{method}\", {args=})|CURSOR|", "description": "Call a method at the end of the frame"},
	"setdef": {"body": "set_deferred(\"{property}\", {value})|CURSOR|", "description": "Set a property at the end of the frame"},

	"tween": {"body": "var tween = create_tween()\ntween.tween_property({object=self}, \"{property}\", {final_value}, {duration=1.0})\n|CURSOR|", "description": "Tween a property"},
	"tweencb": {"body": "var tween = create_tween()\ntween.tween_callback({callable})\n|CURSOR|", "description": "Tween with a callback"},
	"tweenpar": {"body": "var tween = create_tween().set_parallel()\ntween.tween_property({object=self}, \"{prop1}\", {value1}, {duration1=1.0})\ntween.tween_property({object=self}, \"{prop2}\", {value2}, {duration2=1.0})\n|CURSOR|", "description": "Tween two properties at the same time"},

	"print": {"body": "print({value})|CURSOR|", "description": "Print a value"},
	"printerr": {"body": "push_error({message})|CURSOR|", "description": "Report an error (push_error)"},
	"printwarn": {"body": "push_warning({message})|CURSOR|", "description": "Report a warning (push_warning)"},
	"printd": {"body": "print(\"{var}: \", {var})|CURSOR|", "description": "Print a value with its name"},

	"todo": {"body": "# TODO: |CURSOR|", "description": "TODO comment"},
	"fixme": {"body": "# FIXME: |CURSOR|", "description": "FIXME comment"},
	"note": {"body": "# NOTE: |CURSOR|", "description": "NOTE comment"},

	"region": {"body": "#region {name}\n{selection}|CURSOR|\n#endregion", "description": "Foldable region, wraps the selected code"},

	"vec": {"body": "Vector2({x=0}, {y=0})|CURSOR|", "description": "Vector2"},
	"vei": {"body": "Vector2i({x=0}, {y=0})|CURSOR|", "description": "Vector2i"},
	"vecz": {"body": "Vector2.ZERO|CURSOR|", "description": "Vector2.ZERO"},
	"veiz": {"body": "Vector2i.ZERO|CURSOR|", "description": "Vector2i.ZERO"},
	"vec3": {"body": "Vector3({x=0}, {y=0}, {z=0})|CURSOR|", "description": "Vector3"},
	"vec3z": {"body": "Vector3.ZERO|CURSOR|", "description": "Vector3.ZERO"},
	"color": {"body": "Color({r=1}, {g=1}, {b=1})|CURSOR|", "description": "Color from RGB values (0-1)"},
	"rect2": {"body": "Rect2({x=0}, {y=0}, {width}, {height})|CURSOR|", "description": "Rect2"},

	"enum": {"body": "enum {name} {\n\t{value},\n\t|CURSOR|\n}", "description": "Named enum"},
	"const": {"body": "const {name}: {type=int} = |CURSOR|", "description": "Typed constant"},
	"array": {"body": "var {name}: Array[{type=int}] = []|CURSOR|", "description": "Typed array"},

	"collbody": {"body": "func _on_{node=area_2d}_body_entered(body: Node2D) -> void:\n\t|CURSOR|", "description": "body_entered signal handler (Area2D)"},
	"collarea": {"body": "func _on_{node=area_2d}_area_entered(area: Area2D) -> void:\n\t|CURSOR|", "description": "area_entered signal handler (Area2D)"},
	"timeout": {"body": "func _on_{node=timer}_timeout() -> void:\n\t|CURSOR|", "description": "timeout signal handler (Timer)"},
	"pressed": {"body": "func _on_{node=button}_pressed() -> void:\n\t|CURSOR|", "description": "pressed signal handler (Button)"},

	"move2d": {"body": "const SPEED = {speed=300.0}\nconst JUMP_VELOCITY = {jump_velocity=-400.0}\n\nvar gravity: float = ProjectSettings.get_setting(\"physics/2d/default_gravity\")\n\nfunc _physics_process(delta: float) -> void:\n\tif not is_on_floor():\n\t\tvelocity.y += gravity * delta\n\tif Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():\n\t\tvelocity.y = JUMP_VELOCITY\n\tvar direction := Input.get_axis(\"ui_left\", \"ui_right\")\n\tif direction:\n\t\tvelocity.x = direction * SPEED\n\telse:\n\t\tvelocity.x = move_toward(velocity.x, 0, SPEED)\n\tmove_and_slide()|CURSOR|", "description": "Platformer movement for CharacterBody2D"},
	"statem": {"body": "enum State { {first=IDLE}, {second=MOVE} }\n\nvar state: State = State.{first}\n\nfunc set_state(new_state: State) -> void:\n\tstate = new_state\n\tmatch state:\n\t\tState.{first}:\n\t\t\tpass\n\t\tState.{second}:\n\t\t\tpass|CURSOR|", "description": "Simple state machine with an enum"},

	"randf": {"body": "randf_range({min=0.0}, {max=1.0})|CURSOR|", "description": "Random float in a range"},
	"randi": {"body": "randi_range({min=0}, {max=10})|CURSOR|", "description": "Random integer in a range"},
	"clamp": {"body": "clamp({value}, {min}, {max})|CURSOR|", "description": "Clamp a value between min and max"},
	"lerp": {"body": "lerp({from}, {to}, {weight=0.5})|CURSOR|", "description": "Linear interpolation"},
	"movetoward": {"body": "move_toward({from}, {to}, {delta})|CURSOR|", "description": "Move a value toward a target by a step"}
}
